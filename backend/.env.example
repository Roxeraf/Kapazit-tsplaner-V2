# Datenbank (Default: lokale SQLite-Datei, siehe README.md)
# DATABASE_URL=postgresql+psycopg2://kapazitaetsplaner:kapazitaetsplaner@localhost:5432/kapazitaetsplaner

# Jira-Ist-Integration (CONCEPT.md Abschnitt 4). Ohne diese drei Variablen bleibt
# der Sync deaktiviert (GET /jira/status meldet configured=false), Planung
# funktioniert unabhängig davon weiter.
# JIRA_BASE_URL=https://dein-workspace.atlassian.net
# JIRA_EMAIL=dein-servicekonto@firma.de
# JIRA_API_TOKEN=  # https://id.atlassian.com/manage-profile/security/api-tokens

# Optional, nur falls mit Tempo Timesheets gebucht wird: native Jira-Worklogs zeigen dann
# oft den Tempo-Systemaccount statt der echten Person als Autor, deshalb wird mit gesetztem
# Token stattdessen direkt gegen die Tempo-API gesynct (siehe backend/app/tempo_client.py).
# Erzeugen in Jira unter Tempo -> Einstellungen -> API Integration.
# TEMPO_API_TOKEN=
